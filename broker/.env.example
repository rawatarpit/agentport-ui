# Agent Port GitHub broker — server environment.
#
# This file lists names only. Never commit values. The broker runs on Agent
# Port's infrastructure, not the merchant's, and holds the only copy of the
# GitHub App private key, OAuth client secret and webhook secret.

PORT=8790

# Supabase project used for session verification and tenant-scoped reads.
# The anon key is public; the broker never uses the service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# GitHub App credentials. GITHUB_APP_PRIVATE_KEY accepts either a PEM or a
# base64-encoded PEM. The broker normalizes paste damage the same way the
# console did.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Shared service-to-service token. The console sends this on every broker
# request; it is not a GitHub credential and can be rotated independently.
GITHUB_BROKER_TOKEN=

# Narrow Postgres role connection string. The role has NOBYPASSRLS and only
# EXECUTE on agentport_broker.record_github_install. It has no table grants.
# Username through the shared pooler: agentport_github_broker.<project-ref>
BROKER_DATABASE_URL=

# Where one-time install states are stored. Hashes and ids only.
BROKER_STATE_FILE=/var/lib/agentport-github-broker/state.json

# Hosted governor URL copied into the discovery package.
AGENTPORT_WORKER_URL=

# Fixed dashboard origin used only for diagnostics in the broker.
CONSOLE_ORIGIN=https://agentport.relayforge.in
