[Unit]
Description=Agent Port GitHub broker
Documentation=https://agentport.relayforge.in
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentport-broker
Group=agentport-broker
WorkingDirectory=/opt/agentport-github-broker
EnvironmentFile=/etc/agentport/github-broker.env
ExecStart=/usr/bin/node /opt/agentport-github-broker/server.cjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agentport-github-broker
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
