{
  "name": "@agentport/sdk",
  "version": "0.1.0",
  "description": "Give external AI agents a governed, auditable interface to your business capabilities.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": { "agent-port": "./dist/main.js" },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "rm -rf dist-test",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "clean": "rm -rf dist dist-test dist-pilot dist-binary build",
    "pilot": "tsc -p tsconfig.pilot.json && cp -R pilot/static dist-pilot/pilot/static && node dist-pilot/pilot/smoke.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test",
    "lint": "node scripts/check-invariants.mjs",
    "bundle": "node scripts/bundle.mjs",
    "sea": "node scripts/sea.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.7.2"
  }
}
